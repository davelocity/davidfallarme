---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="David Fallarme"
  description="David Fallarme, VP Marketing at Owner.com."
>
  <main id="content">
    <h1>David Fallarme</h1>
    <div class="bio-row">
      <img
        class="portrait"
        src="/images/david-fallarme.jpg"
        alt="David Fallarme"
        width="400"
        height="400"
      />
      <p class="intro">
        Hi, I'm David. I'm currently VP Marketing at Owner.com. I've built
        marketing teams at companies big and small, from public companies
        ($HUBS, $EA) to early stage startups.
      </p>
    </div>
  </main>
  <footer class="site-footer">
    <p>
      <a href="https://www.linkedin.com/in/dfallarme">LinkedIn</a>
      <span class="sep" aria-hidden="true">|</span>
      <a href="https://twitter.com/davelocity">@davelocity</a>
      <span class="sep" aria-hidden="true">|</span>
      <a href="https://www.themarketingstudent.com/">blog</a>
    </p>
  </footer>
</Layout>
